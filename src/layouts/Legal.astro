---
import Base from './Base.astro';

interface Props { title: string; updated: string }
const { title, updated } = Astro.props;
---
<Base title={`${title} · ¡Rumbo a Roma!`}>
  <header class="legal-top">
    <a class="brand" href="/">¡Rumbo a Roma!</a>
  </header>
  <main class="legal">
    <h1>{title}</h1>
    <p class="updated">Última actualización: {updated}</p>
    <slot />
    <nav class="legal-nav" aria-label="Textos legales">
      <a href="/politica-privacidad">Política de privacidad</a>
      <a href="/condiciones-servicio">Condiciones del servicio</a>
      <a href="/">Volver a la tienda</a>
    </nav>
  </main>
</Base>

<style>
  .legal-top { padding: 16px var(--margin); background: var(--paper-deep); }
  .brand { font: 400 26px/1 var(--display); text-transform: uppercase; color: var(--wine); text-decoration: none; }
  .legal { max-width: 72ch; margin: 0 auto; padding: clamp(48px, 8vw, 96px) var(--margin) 96px; display: grid; gap: 16px; }
  h1 { font: 400 clamp(44px, 6vw, 72px)/0.95 var(--display); text-transform: uppercase; color: var(--wine); }
  .updated { color: var(--ink-soft); font-size: 15px; margin-bottom: 16px; }
  .legal :global(h2) { font: 400 28px/1.1 var(--display); text-transform: uppercase; margin-top: 32px; }
  .legal :global(ul) { margin: 0; padding-left: 1.2em; display: grid; gap: 6px; }
  .legal :global(a) { font-weight: 700; }
  .legal-nav { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 48px; padding-top: 24px; font-size: 15px; }
</style>
