---
import '../styles/global.css';
import LandOnAnchor from '../components/LandOnAnchor.astro';
import Analytics from '@vercel/analytics/astro';
interface Props { title: string; description?: string }
const { title, description = 'Fajines y calcetines para pagarnos el viaje a Roma esta Semana Santa. Centro universitario Recoletos.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3e5cf" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/products/0008.webp', Astro.url)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <LandOnAnchor />
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
