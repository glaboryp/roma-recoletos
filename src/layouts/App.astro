---
import '../styles/global.css';
import '../styles/app.css';
import LandOnAnchor from '../components/LandOnAnchor.astro';
interface Props { title: string }
const { title } = Astro.props;
const person = Astro.locals.person!;
const path = Astro.url.pathname;
const links = [
  ...(person.sells ? [{ href: '/panel', label: 'Mis ventas' }] : []),
  ...(person.role === 'admin'
    ? [
        { href: '/admin', label: 'Pedidos' },
        { href: '/admin/productos', label: 'Productos' },
        { href: '/admin/personas', label: 'Personas' },
      ]
    : []),
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · ¡Rumbo a Roma!</title>
    <LandOnAnchor />
  </head>
  <body class="app">
    <header class="topbar">
      <a class="brand" href="/">¡Rumbo a Roma!</a>
      <nav aria-label="Panel">
        {links.map((l) => <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}
      </nav>
      <div class="who">
        <span>{person.name}</span>
        <button class="btn ghost small" type="button" id="salir">Salir</button>
      </div>
    </header>
    <main class="canvas">
      <slot />
    </main>
    <script>
      const nav = [...document.querySelectorAll<HTMLAnchorElement>('.topbar nav a')];
      const current = nav.find((a) => a.hasAttribute('aria-current'));
      const mark = (link?: HTMLAnchorElement) => nav.forEach((a) => (a === link ? a.setAttribute('aria-current', 'page') : a.removeAttribute('aria-current')));
      const busy = (on: boolean) => {
        document.body.classList.toggle('loading', on);
        document.querySelector('main')!.toggleAttribute('aria-busy', on);
      };

      document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest<HTMLAnchorElement>('a[href]');
        if (!a || e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || a.target || a.hasAttribute('download')) return;
        const url = new URL(a.href);
        if (url.origin !== location.origin || (url.hash && url.pathname + url.search === location.pathname + location.search)) return;
        if (nav.includes(a)) mark(a);
        busy(true);
      });
      document.addEventListener('submit', (e) => {
        const f = e.target as HTMLFormElement;
        if (e.defaultPrevented) return;
        // Re-sending the same filters only moves to #pedidos without loading a page, so there is nothing to wait for.
        if (f.method === 'get') {
          const url = new URL(f.action);
          url.search = new URLSearchParams(new FormData(f) as unknown as Record<string, string>).toString();
          if (url.href === location.href) return;
        }
        busy(true);
      });
      // Back/forward restores this page from cache with the loading state still on.
      addEventListener('pageshow', (e) => { if (e.persisted) { busy(false); mark(current); } });

      document.getElementById('salir')!.addEventListener('click', async () => {
        await fetch('/api/auth/sign-out', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}' });
        location.href = '/';
      });
    </script>
  </body>
</html>
