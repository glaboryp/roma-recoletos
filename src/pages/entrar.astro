---
import Base from '../layouts/Base.astro';
import { auth } from '../lib/auth.ts';

if (Astro.locals.person) return Astro.redirect('/panel');
const session = await auth.api.getSession({ headers: Astro.request.headers });
const refused = Astro.url.searchParams.has('error') || !!session;
---
<Base title="Entrar · ¡Rumbo a Roma!">
  <main class="login">
    <section aria-labelledby="h">
      <h1 id="h">Entrar</h1>
      <p>Para las que vendemos: aquí ves tus ventas y, si llevas las compras, todos los pedidos.</p>
      {refused && (
        <p class="notice" role="alert">
          {session ? `${session.user.email} no está dado de alta.` : 'Ese correo no está dado de alta.'} Pide a quien lleva las compras que te añada con tu Gmail.
        </p>
      )}
      <button class="btn" type="button" id="google">
        <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20"><path fill="currentColor" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3zM12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22zM6.4 14a6 6 0 0 1 0-3.9V7.5H3.1a10 10 0 0 0 0 9zM12 5.9c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 0 0 3.1 7.5L6.4 10C7.2 7.7 9.4 5.9 12 5.9z"/></svg>
        Entrar con Google
      </button>
      <p><a href="/">Volver a la tienda</a></p>
    </section>
  </main>
</Base>

<script>
  document.getElementById('google')!.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    b.disabled = true;
    const r = await fetch('/api/auth/sign-in/social', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ provider: 'google', callbackURL: '/panel', errorCallbackURL: '/entrar?error=1' }),
    });
    const data = await r.json().catch(() => ({}));
    if (data.url) location.href = data.url;
    else { b.disabled = false; alert('No se ha podido conectar con Google. Inténtalo otra vez.'); }
  });
</script>

<style>
  .login { min-height: 100svh; display: grid; place-items: center; padding: var(--margin); background: var(--wine); }
  section { width: min(520px, 100%); background: var(--paper); padding: clamp(28px, 5vw, 48px); display: grid; gap: 20px; justify-items: start; }
  h1 { font: 400 clamp(56px, 8vw, 88px)/0.95 var(--display); text-transform: uppercase; color: var(--wine); }
</style>
