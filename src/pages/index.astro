---
import Base from '../layouts/Base.astro';
import { q, tx, type Product, type Person } from '../lib/db.ts';
import { orderTotals, euros, formatTiers, type Line } from '../lib/pricing.ts';
import { specimen } from '../lib/muestras.ts';

const products = await q<Product>('select * from products where active order by position, id');
const sellers = await q<Pick<Person, 'id' | 'name'>>('select id, name from people where active and sells order by name');

const options = (p: Product) => (p.variants.length ? p.variants : [null]);
const unit = (p: Product) => (p.name.toLowerCase().includes('calcet') ? 'pares' : 'uds.');

let error = '';
const values = { name: '', phone: '', seller: Astro.url.searchParams.get('de') ?? '', notes: '' };
const qty: Record<string, number> = {};

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  for (const k of Object.keys(values) as (keyof typeof values)[]) values[k] = String(f.get(k) ?? '').trim().slice(0, 500);
  const lines: Line[] = [];
  for (const p of products) {
    options(p).forEach((variant, i) => {
      const key = `q-${p.id}-${i}`;
      const n = Math.min(50, Math.max(0, Number.parseInt(String(f.get(key) ?? '0'), 10) || 0));
      qty[key] = n;
      if (n) lines.push({ product_id: p.id, variant, qty: n });
    });
  }
  const seller = sellers.find((s) => String(s.id) === values.seller);
  if (!lines.length) error = 'Elige al menos un producto.';
  else if (!values.name) error = 'Escribe tu nombre y apellidos.';
  else if (!values.phone) error = 'Escribe tu móvil para que podamos darte el pedido.';
  else if (!seller) error = 'Elige de parte de quién vienes.';
  else {
    const { total, cost } = orderTotals(products, lines);
    const id = await tx(async (c) => {
      const { rows: [o] } = await c.query(
        `insert into orders (seller_id, buyer_name, buyer_phone, notes, total_cents, cost_cents)
         values ($1, $2, $3, $4, $5, $6) returning id`,
        [seller.id, values.name, values.phone, values.notes || null, total, cost],
      );
      for (const l of lines) {
        await c.query('insert into order_items (order_id, product_id, variant, qty) values ($1, $2, $3, $4)', [o.id, l.product_id, l.variant, l.qty]);
      }
      return o.id as string;
    });
    return Astro.redirect(`/pedido/${id}`, 303);
  }
}

const pricing = products.map((p) => ({ id: p.id, name: p.name, unit: unit(p), tiers: p.tiers, cost_cents: 0 }));
---
<Base title="¡Rumbo a Roma! · Fajines y calcetines de Recoletos">
  <header class="hero">
    <nav class="top" aria-label="Productos">
      <span class="mark">recoletos</span>
      {products.map((p) => <a class="product-link" href={`#p-${p.id}`}>{p.name}</a>)}
      <a href="/entrar">Vendedoras</a>
    </nav>
    <div class="poster">
      <h1>¡Rumbo a Roma!</h1>
      <p class="lead">Esta Semana Santa queremos vivir una experiencia muy especial y conocer al Santo Padre. Vendemos fajines y calcetines para pagarnos el viaje.</p>
      <ul class="prices">{products.map((p) => <li>{p.name} <span>{formatTiers(p.tiers)}</span></li>)}</ul>
      <a class="btn" href="#pedido">Hacer mi pedido</a>
    </div>
  </header>

  <main>
    <form method="post" action="/#datos" id="pedido" class="order" novalidate>
      <section class="catalogue" aria-labelledby="cat-h">
        <div class="cat-intro rise">
          <h2 id="cat-h">Elige lo que quieras</h2>
          <p>Los packs se suman solos: dos pares de calcetines cuestan 16 €, aunque sean de colores distintos.</p>
        </div>

        {products.map((p) => (
          <article class="cat rise" id={`p-${p.id}`} data-product={p.id}>
            <div class="preview">
              <img class="preview-main" src={p.images[0]} alt={`${p.name}: foto del producto`} width="1050" height="1400" loading="lazy" />
              {p.images.length > 1 && (
                <div class="thumbs">
                  {p.images.slice(0, 5).map((src, i) => (
                    <button type="button" class="thumb" data-src={src} aria-label={`Ver foto ${i + 1} de ${p.name}`} aria-pressed={i === 0 ? 'true' : 'false'}>
                      <img src={src} alt="" width="96" height="96" loading="lazy" />
                    </button>
                  ))}
                </div>
              )}
            </div>
            <div class="cat-body">
              <div class="cat-head">
                <h3>{p.name}</h3>
                <p class="tag">{formatTiers(p.tiers)}</p>
              </div>
              <p class="desc">{p.description}</p>
              <ul class="items">
                {options(p).map((v, i) => {
                  const key = `q-${p.id}-${i}`;
                  const label = v ?? p.name;
                  return (
                    <li class="item">
                      <img src={specimen(v, p.images[0])} alt="" width="64" height="80" loading="lazy" />
                      <label for={key}>{label}</label>
                      <div class="stepper">
                        <button type="button" data-step="-1" aria-label={`Quitar ${label}`}>
                          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12" /></svg>
                        </button>
                        <input class="num" id={key} name={key} type="number" inputmode="numeric" min="0" max="50" value={qty[key] ?? 0} />
                        <button type="button" data-step="1" aria-label={`Añadir ${label}`}>
                          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M10 4v12" /></svg>
                        </button>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </div>
          </article>
        ))}
      </section>

      <section class="details" id="datos" aria-labelledby="datos-h">
        <div class="details-form">
          <h2 id="datos-h">Tus datos</h2>
          {error && <p class="notice" role="alert">{error}</p>}
          <label class="field">
            <span>Nombre y apellidos</span>
            <input class="input" name="name" autocomplete="name" required value={values.name} />
          </label>
          <label class="field">
            <span>Móvil</span>
            <input class="input" name="phone" type="tel" autocomplete="tel" inputmode="tel" required value={values.phone} />
          </label>
          <label class="field">
            <span>¿De parte de quién vienes?</span>
            <select class="input" name="seller" required>
              <option value="">Elige a una de nosotras</option>
              {sellers.map((s) => <option value={s.id} selected={String(s.id) === values.seller}>{s.name}</option>)}
            </select>
          </label>
          <label class="field">
            <span>Comentario <small>(estampado que no sale, tallas…)</small></span>
            <textarea class="input" name="notes">{values.notes}</textarea>
          </label>
        </div>

        <aside class="summary" aria-labelledby="sum-h">
          <h2 id="sum-h">Tu pedido</h2>
          <ul class="sum-lines" data-lines>
            <li class="sum-empty">Aún no has elegido nada.</li>
          </ul>
          <p class="sum-total"><span>Total</span> <strong class="num" data-total>0 €</strong></p>
          <button class="btn" type="submit">Enviar pedido</button>
          <p class="sum-note">Al enviarlo te enseñamos el número de Bizum y lo que tienes que pagar.</p>
        </aside>
      </section>

      <div class="bar" data-bar hidden>
        <p><span data-count></span> · <strong class="num" data-bar-total></strong></p>
        <a class="btn light small" href="#datos">Terminar pedido</a>
      </div>
    </form>

    <section class="thanks" aria-labelledby="thanks-h">
      <div class="strip">
        <img src="/products/0012.webp" alt="Cinco fajines estampados doblados" width="1400" height="1050" loading="lazy" />
        <img src="/products/0005.webp" alt="Calcetines brillantes colgados por colores" width="1400" height="836" loading="lazy" />
        <img src="/products/0002.webp" alt="Calcetines de chico con dibujos" width="1050" height="1400" loading="lazy" />
      </div>
      <div class="band rise">
        <h2 id="thanks-h">¡Muchas gracias por tu ayuda!</h2>
        <p>Con tu compra <a href="#pedido">colaboras con nuestro viaje</a> a Roma esta Semana Santa.</p>
      </div>
    </section>
  </main>

  <footer class="foot">
    <p class="wordmark">recoletos</p>
    <p class="sub">-centro universitario-</p>
    <p class="sellers">¿Vendes con nosotras? <a href="/entrar">Entra con tu Gmail</a></p>
    <p class="legal-links"><a href="/politica-privacidad">Política de privacidad</a> <a href="/condiciones-servicio">Condiciones del servicio</a></p>
  </footer>
</Base>

<script is:inline type="application/json" id="pricing" set:html={JSON.stringify(pricing)} />

<script>
  import { priceFor, euros, type Tier } from '../lib/pricing.ts';

  type P = { id: number; name: string; unit: string; tiers: Tier[] };
  const products: P[] = JSON.parse(document.getElementById('pricing')!.textContent!);
  const form = document.getElementById('pedido') as HTMLFormElement;
  const inputs = [...form.querySelectorAll<HTMLInputElement>('.stepper input')];
  const lines = form.querySelector('[data-lines]')!;
  const totalEl = form.querySelector('[data-total]')!;
  const bar = form.querySelector<HTMLElement>('[data-bar]')!;
  document.documentElement.classList.add('js');

  function update() {
    let total = 0;
    let count = 0;
    const html: string[] = [];
    for (const p of products) {
      const mine = inputs.filter((i) => i.name.startsWith(`q-${p.id}-`));
      const n = mine.reduce((s, i) => s + (Math.max(0, Number(i.value)) || 0), 0);
      mine.forEach((i) => i.closest('.item')!.classList.toggle('on', Number(i.value) > 0));
      if (!n) continue;
      const price = priceFor(p.tiers, n);
      const saved = n * p.tiers[0].cents - price;
      total += price;
      count += n;
      html.push(`<li><span>${p.name} <small>${n} ${n === 1 ? p.unit.replace(/e?s\.?$/, '') : p.unit}</small></span><span class="num">${euros(price)}${saved > 0 ? `<small>ahorras ${euros(saved)}</small>` : ''}</span></li>`);
    }
    lines.innerHTML = html.join('') || '<li class="sum-empty">Aún no has elegido nada.</li>';
    totalEl.textContent = euros(total);
    bar.hidden = count === 0;
    bar.querySelector('[data-count]')!.textContent = `${count} ${count === 1 ? 'cosa' : 'cosas'}`;
    bar.querySelector('[data-bar-total]')!.textContent = euros(total);
  }

  form.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-step]');
    if (!btn) return;
    const input = btn.parentElement!.querySelector('input')!;
    input.value = String(Math.min(50, Math.max(0, (Number(input.value) || 0) + Number(btn.dataset.step))));
    update();
  });
  form.addEventListener('input', update);
  update();

  // The thumbnails under each product photo switch the big photo.
  for (const cat of document.querySelectorAll<HTMLElement>('.cat')) {
    const main = cat.querySelector<HTMLImageElement>('.preview-main')!;
    for (const t of cat.querySelectorAll<HTMLButtonElement>('.thumb')) {
      t.addEventListener('click', () => {
        main.src = t.dataset.src!;
        cat.querySelectorAll('.thumb').forEach((o) => o.setAttribute('aria-pressed', String(o === t)));
      });
    }
  }

  // Entrances: each section's parts rise in once, staggered; content is visible without script.
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }, { rootMargin: '0px 0px -10% 0px' });
  document.querySelectorAll('.rise').forEach((el) => io.observe(el));
</script>

<style>
  /* Hero: the poster itself */
  .hero { min-height: 100svh; display: grid; grid-template-rows: auto 1fr; background: var(--paper); }
  .top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 24px; padding: 20px var(--margin); font-size: 15px; font-weight: 600; }
  .top a { text-decoration: none; transition: color 160ms var(--ease); }
  .top a:hover { color: var(--wine); text-decoration: underline; }
  .mark { font-weight: 800; font-size: 22px; letter-spacing: -0.02em; margin-right: auto; }
  .poster { display: grid; justify-items: center; align-content: center; gap: 28px; padding: 32px var(--margin) clamp(56px, 8vw, 112px); text-align: center; }
  .poster h1 { color: var(--wine); font: 400 clamp(72px, 13vw, 210px)/0.9 var(--display); letter-spacing: -0.01em; text-transform: uppercase; }
  .lead { max-width: 40ch; font-size: clamp(20px, 1.8vw, 26px); line-height: 1.4; color: var(--wine); }
  .prices { list-style: none; margin: 8px 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 40px; font: 400 34px/1.2 var(--hand); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink); }
  .prices li { white-space: nowrap; }
  .prices span { color: var(--wine); white-space: nowrap; }

  /* Catalogue: index with preview */
  .catalogue { padding: clamp(96px, 12vw, 180px) var(--margin) 0; display: grid; gap: clamp(96px, 11vw, 160px); }
  .cat-intro { display: grid; grid-template-columns: repeat(12, 1fr); gap: 16px 24px; align-items: end; }
  .cat-intro h2, .details h2, .band h2 {
    font: 400 clamp(44px, 6vw, 88px)/0.95 var(--display); text-transform: uppercase; color: var(--wine); letter-spacing: -0.01em;
  }
  .cat-intro h2 { grid-column: 1 / 8; }
  .cat-intro p { grid-column: 8 / 13; font-size: 18px; }

  .cat { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; align-items: start; }
  .cat:nth-of-type(even) .preview { order: 2; grid-column: 7 / 13; }
  .cat:nth-of-type(even) .cat-body { grid-column: 1 / 7; }
  .preview { grid-column: 1 / 6; position: relative; display: grid; gap: 8px; }
  .preview-main { width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; }
  .thumbs { display: flex; gap: 8px; }
  .thumb { padding: 0; border: 0; background: none; cursor: pointer; opacity: 0.6; transition: opacity 160ms var(--ease), transform 160ms var(--ease); }
  .thumb img { width: 64px; height: 64px; object-fit: cover; }
  .thumb:hover { opacity: 1; transform: translateY(-2px); }
  .thumb[aria-pressed='true'] { opacity: 1; outline: 3px solid var(--ink); outline-offset: 2px; }

  .cat-body { grid-column: 7 / 13; display: grid; gap: 20px; padding-top: 8px; }
  .cat-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; }
  .cat-head h3 { font: 400 clamp(36px, 4vw, 48px)/1 var(--display); text-transform: uppercase; letter-spacing: -0.005em; }
  .tag { font: 400 38px/1.1 var(--hand); letter-spacing: 0.06em; text-transform: uppercase; color: var(--wine); }
  .desc { font-size: 18px; max-width: 46ch; }

  .items { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 10px; max-width: 520px; }
  .item { display: grid; grid-template-columns: 64px 1fr auto; align-items: center; gap: 14px; padding: 6px 0; }
  .item img { width: 64px; height: 80px; object-fit: cover; transition: transform 240ms var(--ease); }
  .item.on img { transform: scale(1.06); }
  .item label { font-weight: 700; font-size: 18px; line-height: 1.25; }
  .item.on label { color: var(--wine); }

  .stepper { display: flex; align-items: center; background: var(--paper-raised); }
  .stepper button { display: none; width: 40px; height: 44px; border: 0; background: transparent; cursor: pointer; transition: background-color 160ms var(--ease); }
  :global(.js) .stepper button { display: grid; place-items: center; }
  .stepper button:hover { background: var(--paper-deep); }
  .stepper button:active { background: var(--line); }
  .stepper svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; }
  .stepper input { width: 52px; height: 44px; text-align: center; border: 0; background: transparent; font-weight: 800; font-size: 18px; -moz-appearance: textfield; }
  :global(.js) .stepper input { width: 34px; }
  .stepper input::-webkit-inner-spin-button { -webkit-appearance: none; }
  .item.on .stepper { background: var(--wine); color: var(--paper); }
  .item.on .stepper button:hover { background: var(--wine-deep); }

  /* Details + summary */
  .details {
    margin-top: clamp(96px, 12vw, 180px); padding: clamp(56px, 7vw, 96px) var(--margin);
    background: var(--paper-deep); display: grid; grid-template-columns: repeat(12, 1fr); gap: 48px 24px; align-items: start;
  }
  .details-form { grid-column: 1 / 7; display: grid; gap: 20px; }
  .details-form h2 { margin-bottom: 8px; }
  .summary { grid-column: 8 / 13; position: sticky; top: 24px; background: var(--ink); color: var(--paper); padding: 32px; display: grid; gap: 20px; }
  .summary h2 { font: 400 48px/1 var(--display); text-transform: uppercase; color: var(--paper); }
  .sum-lines { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .sum-lines :global(li) { display: flex; justify-content: space-between; gap: 16px; font-weight: 600; }
  .sum-lines :global(small) { display: block; font-size: 15px; font-weight: 500; opacity: 0.85; text-align: inherit; }
  .sum-lines :global(.num) { text-align: right; }
  .sum-lines :global(.sum-empty) { opacity: 0.85; font-weight: 500; }
  .sum-total { display: flex; justify-content: space-between; align-items: baseline; padding-top: 8px; }
  .sum-total strong { font: 400 48px/1 var(--display); }
  .summary .btn { background: var(--paper); color: var(--wine); }
  .summary .btn:hover { background: var(--paper-raised); }
  .sum-note { font-size: 15px; opacity: 0.9; }

  .bar {
    position: fixed; z-index: 5; left: 50%; bottom: 16px; transform: translateX(-50%);
    width: min(560px, calc(100% - 2 * var(--margin)));
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 10px 10px 10px 20px; background: var(--wine); color: var(--paper);
    box-shadow: 0 10px 30px rgb(34 48 77 / 0.3); font-weight: 600;
    animation: up 320ms var(--ease);
  }
  .bar[hidden] { display: none; }
  @keyframes up { from { transform: translate(-50%, 24px); opacity: 0; } }

  /* Thanks */
  .thanks { margin-top: 0; }
  .strip { display: grid; grid-template-columns: repeat(3, 1fr); }
  .strip img { width: 100%; height: 40svh; min-height: 260px; object-fit: cover; }
  .band { background: var(--wine); color: var(--paper); padding: clamp(56px, 8vw, 120px) var(--margin); display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; align-items: end; }
  .band h2 { grid-column: 1 / 8; color: var(--paper); }
  .band p { grid-column: 8 / 13; font-size: 28px; line-height: 1.35; }
  .band a { text-decoration-thickness: 4px; text-underline-offset: 6px; font-weight: 700; }
  .band a:hover { text-decoration-color: var(--paper-deep); }

  /* Footer: the poster's signature */
  .foot { padding: clamp(64px, 9vw, 128px) var(--margin) 48px; background: var(--ink); color: var(--paper); display: grid; justify-items: center; text-align: center; gap: 4px; }
  .wordmark { font: 800 clamp(72px, 13vw, 200px)/0.9 var(--text); letter-spacing: -0.04em; }
  .foot .sub { font-weight: 700; font-size: 18px; }
  .sellers { margin-top: 56px; font-size: 18px; }
  .sellers a { font-weight: 700; }
  .sellers a:hover { color: var(--paper-deep); }
  .legal-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 24px; margin-top: 24px; font-size: 15px; }
  .legal-links a:hover { color: var(--paper-deep); }

  /* Entrances */
  :global(.js) .rise > * { opacity: 0; transform: translateY(24px); transition: opacity 700ms var(--ease), transform 700ms var(--ease); }
  :global(.js) .rise.in > * { opacity: 1; transform: none; }
  :global(.js) .rise.in > :nth-child(2) { transition-delay: 80ms; }
  :global(.js) .rise.in > :nth-child(3) { transition-delay: 160ms; }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .rise > * { opacity: 1; transform: none; }
  }

  @media (max-width: 900px) {
    .cat-intro h2, .cat-intro p { grid-column: 1 / -1; }
    .cat, .cat:nth-of-type(even) { grid-template-columns: 1fr; }
    .preview, .cat-body, .cat:nth-of-type(even) .preview, .cat:nth-of-type(even) .cat-body { grid-column: 1 / -1; order: 0; }
    .preview-main { aspect-ratio: auto; max-height: 80svh; }
    .items { grid-template-columns: 1fr; }
    .details-form, .summary { grid-column: 1 / -1; }
    .summary { position: static; }
    .band h2, .band p { grid-column: 1 / -1; }
  }

  @media (max-width: 600px) {
    .top { align-items: center; padding: 16px var(--margin); }
    .top .product-link { display: none; }
    .poster { gap: 36px; }
    .poster h1 { font-size: 19vw; }
    .lead { font-size: 18px; }
    .prices { flex-direction: column; gap: 2px; font-size: 22px; }
    .prices li { white-space: normal; }
    .poster .btn { width: 100%; }
    .tag { font-size: 30px; }
    .band p { font-size: 18px; }
    .strip { grid-template-columns: 1fr 1fr; }
    .strip img:first-child { grid-column: 1 / -1; height: auto; aspect-ratio: 4 / 3; }
    .strip img { height: auto; min-height: 0; aspect-ratio: 1; }
    .summary { padding: 24px; }
    .bar { bottom: 8px; }
  }
</style>
