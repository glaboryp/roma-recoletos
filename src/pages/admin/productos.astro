---
import { put } from '@vercel/blob';
import App from '../../layouts/App.astro';
import ProductForm from '../../components/ProductForm.astro';
import { q, one, type Product } from '../../lib/db.ts';
import { parseTiers, parseEuros, formatTiers, euros } from '../../lib/pricing.ts';
import { slug, hasBundledSpecimen } from '../../lib/muestras.ts';

let error = '';
let saved = Astro.url.searchParams.get('ok');

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const id = Number(f.get('id')) || null;
  const name = String(f.get('name') ?? '').trim();
  const tiers = parseTiers(String(f.get('tiers') ?? ''));
  const cost = parseEuros(String(f.get('cost') ?? ''));
  const current = id ? await one<Product>('select * from products where id = $1', [id]) : undefined;
  const files = (f.getAll('photos') as File[]).filter((file) => file.size > 0);
  const remove = f.getAll('remove').map(String);
  // One row per variant, in form order: v-name-N, v-orig-N (name before editing), v-file-N, v-stock-N, v-del-N.
  const rows = [...f.keys()].filter((k) => k.startsWith('v-name-')).map((k) => k.slice(7))
    .sort((a, b) => Number(a) - Number(b))
    .map((i) => {
      const file = f.get(`v-file-${i}`);
      return {
        name: String(f.get(`v-name-${i}`) ?? '').trim(),
        orig: String(f.get(`v-orig-${i}`) ?? ''),
        file: file instanceof File && file.size > 0 ? file : null,
        stock: String(f.get(`v-stock-${i}`) ?? '').trim(),
        del: f.get(`v-del-${i}`) === 'on',
      };
    })
    .filter((r) => !r.del);
  const unnamed = rows.some((r) => !r.name);
  const variants = rows.map((r) => r.name);
  // Every variant needs a close-up: uploaded now, uploaded before (and kept), or bundled with the site.
  const withoutPhoto = rows.find(
    (r) => r.name && !r.file && !current?.variant_images[r.orig] && !hasBundledSpecimen(r.name),
  );
  const allFiles = [...files, ...rows.flatMap((r) => (r.file ? [r.file] : []))];

  if (!name) error = 'El producto necesita un nombre.';
  else if (!tiers) error = 'Revisa los precios: escribe cantidad x precio, por ejemplo "1x9, 2x16". Tiene que haber precio para 1.';
  else if (cost === null) error = 'Revisa el coste: un número en euros, por ejemplo 1,5.';
  else if (id && !current) error = 'Ese producto ya no existe.';
  else if (unnamed) error = 'Hay una variante sin nombre: escríbelo o quita esa fila.';
  else if (new Set(variants).size !== variants.length) error = 'Hay dos variantes con el mismo nombre.';
  else if (rows.some((r) => r.stock && !/^\d+$/.test(r.stock))) error = 'Las existencias tienen que ser un número entero (0 o más), o vacías si siempre hay.';
  else if (withoutPhoto) error = `La variante «${withoutPhoto.name}» necesita una foto de detalle.`;
  else if (allFiles.some((file) => !file.type.startsWith('image/') || file.size > 4_000_000)) error = 'Las fotos tienen que ser imágenes de menos de 4 MB.';
  else if (allFiles.length && !process.env.BLOB_READ_WRITE_TOKEN) error = 'Falta conectar Vercel Blob (BLOB_READ_WRITE_TOKEN) para poder subir fotos.';
  else {
    const upload = async (file: File, label: string) =>
      (await put(`productos/${slug(label)}-${file.name}`, file, { access: 'public', addRandomSuffix: true })).url;
    const uploaded: string[] = [];
    for (const file of files) uploaded.push(await upload(file, name));
    // "keep" carries the current photos in the order shown in the form; only known photos are accepted.
    const keep = f.getAll('keep').map(String).filter((src) => current?.images.includes(src));
    const ordered = [...keep, ...(current?.images ?? []).filter((src) => !keep.includes(src))];
    const images = [...ordered.filter((src) => !remove.includes(src)), ...uploaded];
    // Close-ups are keyed by variant name; a renamed variant keeps its photo.
    const variantImages: Record<string, string> = {};
    for (const r of rows) {
      const src = r.file ? await upload(r.file, `${name}-${r.name}`) : current?.variant_images[r.orig];
      if (src) variantImages[r.name] = src;
    }
    const variantStock = Object.fromEntries(rows.filter((r) => r.stock).map((r) => [r.name, Number(r.stock)]));
    const params = [name, String(f.get('description') ?? '').trim(), JSON.stringify(tiers), cost, variants, images, f.get('active') === 'on', JSON.stringify(variantImages), JSON.stringify(variantStock)];
    const row = id
      ? await one<{ id: number }>('update products set name=$1, description=$2, tiers=$3, cost_cents=$4, variants=$5, images=$6, active=$7, variant_images=$8, variant_stock=$9 where id=$10 returning id', [...params, id])
      : await one<{ id: number }>('insert into products (name, description, tiers, cost_cents, variants, images, active, variant_images, variant_stock, position) values ($1,$2,$3,$4,$5,$6,$7,$8,$9,(select coalesce(max(position),0)+1 from products)) returning id', params);
    return Astro.redirect(`/admin/productos?ok=${row!.id}#p${row!.id}`, 303);
  }
  saved = null;
}

const products = await q<Product>('select * from products order by position, id');
---
<App title="Productos">
  <div class="title-row">
    <div>
      <h1>Productos</h1>
      <p class="finding">Los cambios de precio valen para los pedidos nuevos; los pedidos ya hechos guardan su total y su coste.</p>
    </div>
    <a class="btn small" href="#nuevo">Añadir producto</a>
  </div>
  {error && <p class="notice" role="alert">{error}</p>}
  {saved && <p class="notice ok" role="status">Guardado.</p>}

  {products.map((p) => (
    <section class="block" aria-labelledby={`h${p.id}`}>
      <h2 id={`h${p.id}`}>{p.name} <span class="muted">· {formatTiers(p.tiers)} · coste {euros(p.cost_cents)}{!p.active && ' · oculto'}</span></h2>
      <ProductForm product={p} />
    </section>
  ))}

  <section class="block" aria-labelledby="new-h">
    <h2 id="new-h">Producto nuevo</h2>
    <ProductForm />
  </section>
</App>

<script>
  // Phone photos are often over the 4 MB upload limit: shrink them to 1600px WebP before sending.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-add-variant]')) {
    button.addEventListener('click', () => {
      const template = button.parentElement!.querySelector<HTMLTemplateElement>('[data-variant-template]')!;
      const i = String(Number(button.dataset.next));
      button.dataset.next = String(Number(i) + 1);
      button.before(document.createRange().createContextualFragment(template.innerHTML.replaceAll('__i__', i)));
      button.previousElementSibling!.querySelector('input')!.focus();
    });
  }

  document.addEventListener('click', (e) => {
    (e.target as HTMLElement).closest('[data-remove-row]')?.closest('.variant-row')?.remove();
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-move]');
    if (!btn) return;
    const photo = btn.closest('[data-photo]')!;
    const target = btn.dataset.move === '-1' ? photo.previousElementSibling : photo.nextElementSibling;
    if (!target) return;
    if (btn.dataset.move === '-1') target.before(photo);
    else target.after(photo);
    btn.focus();
  });

  // Uploads can take a few seconds: lock the button so the form is not sent twice.
  document.addEventListener('submit', (e) => {
    const btn = (e.target as HTMLFormElement).querySelector<HTMLButtonElement>('button[data-busy-label]');
    if (!btn) return;
    btn.disabled = true;
    btn.setAttribute('aria-busy', 'true');
    btn.innerHTML = `<span class="spinner" aria-hidden="true"></span>${btn.dataset.busyLabel}`;
  });
  // Coming back with the browser's back button must not leave a button stuck in "Guardando…".
  window.addEventListener('pageshow', (e) => { if (e.persisted) location.reload(); });

  document.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    if (!input.matches('input[data-shrink]')) return;
    const out = new DataTransfer();
      for (const file of input.files ?? []) {
        const bmp = await createImageBitmap(file);
        const scale = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
        const canvas = new OffscreenCanvas(Math.round(bmp.width * scale), Math.round(bmp.height * scale));
        canvas.getContext('2d')!.drawImage(bmp, 0, 0, canvas.width, canvas.height);
        const blob = await canvas.convertToBlob({ type: 'image/webp', quality: 0.82 });
        out.items.add(new File([blob], file.name.replace(/\.\w+$/, '') + '.webp', { type: 'image/webp' }));
      }
    input.files = out.files;
  });
</script>
