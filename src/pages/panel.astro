---
import App from '../layouts/App.astro';
import DeliveredToggle from '../components/DeliveredToggle.astro';
import { q } from '../lib/db.ts';
import { listOrders, describe, shortDate, isUuid } from '../lib/orders.ts';
import { euros } from '../lib/pricing.ts';

const me = Astro.locals.person!;
if (!me.sells) return Astro.redirect('/admin');

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const id = String(f.get('id') ?? '');
  if (f.get('action') === 'delivered' && isUuid(id)) {
    await q('update orders set delivered = $2 where id = $1 and seller_id = $3', [id, f.get('delivered') === 'true', me.id]);
  }
  return Astro.redirect('/panel', 303);
}
const orders = await listOrders('where o.seller_id = $1', [me.id]);
const sold = orders.reduce((s, o) => s + o.total_cents, 0);
const cost = orders.reduce((s, o) => s + o.cost_cents, 0);
const link = new URL(`/?de=${me.id}`, Astro.url).href;
---
<App title="Mis ventas">
  <div class="title-row">
    <div>
      <h1>Hola, {me.name.split(' ')[0]}</h1>
      <p class="finding">
        {orders.length === 0
          ? 'Aún no tienes pedidos. Comparte tu enlace y aparecerán aquí.'
          : `Llevas ${orders.length} ${orders.length === 1 ? 'pedido' : 'pedidos'}. ¡Gracias por vender!`}
      </p>
    </div>
  </div>

  <p class="ledger">
    <span>Vendido <b>{euros(sold)}</b></span> <span>− material <b>{euros(cost)}</b></span>
    <span class="net">llevas <strong>{euros(sold - cost)}</strong> ganados para el viaje</span>
  </p>

  <section class="block" aria-labelledby="link-h">
    <h2 id="link-h">Tu enlace</h2>
    <p>Quien entre por aquí ya te tiene elegida en "¿De parte de quién vienes?".</p>
    <div class="toolbar">
      <input class="input" readonly value={link} aria-label="Tu enlace" style="flex:1 1 280px" />
      <button class="btn small" type="button" data-copy={link}>Copiar enlace</button>
      <a class="btn ghost small" href={`https://wa.me/?text=${encodeURIComponent(`¡Vamos a Roma esta Semana Santa! Ayúdanos comprando fajines o calcetines: ${link}`)}`}>Enviar por WhatsApp</a>
    </div>
  </section>

  <section class="block" aria-labelledby="orders-h">
    <h2 id="orders-h">Tus pedidos <span class="muted">({orders.length})</span></h2>
    {orders.length === 0 ? (
      <p class="empty">Cuando alguien haga un pedido de tu parte saldrá aquí, con su teléfono y lo que ha pedido.</p>
    ) : (
      <div class="table-wrap">
        <table class="stack">
          <thead><tr><th>Fecha</th><th>Quién</th><th>Qué</th><th class="r">Total</th><th class="r">Material</th><th>Entrega</th></tr></thead>
          <tbody>
            {orders.map((o) => (
              <tr>
                <td class="num">{shortDate(o.created_at)}</td>
                <td><strong>{o.buyer_name}</strong>{o.buyer_phone && <a class="sub" href={`tel:${o.buyer_phone}`}>{o.buyer_phone}</a>}</td>
                <td>{describe(o.items)}{o.notes && <span class="sub">{o.notes}</span>}</td>
                <td class="r"><strong>{euros(o.total_cents)}</strong></td>
                <td class="r muted">{euros(o.cost_cents)}</td>
                <td><DeliveredToggle id={o.id} delivered={o.delivered} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>
</App>

<script>
  document.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    await navigator.clipboard.writeText(b.dataset.copy!);
    b.textContent = 'Copiado';
    setTimeout(() => (b.textContent = 'Copiar enlace'), 2000);
  });
</script>
