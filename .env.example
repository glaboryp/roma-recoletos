# Neon: cadena de conexión (Vercel la crea sola con la integración de Neon)
DATABASE_URL=
# URL pública de la web, p.ej. https://rumbo-a-roma.vercel.app
BETTER_AUTH_URL=
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# Google Cloud Console → Credenciales → ID de cliente OAuth (aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail de Recoletos para avisar a las vendedoras de cada pedido nuevo.
# Cuenta de Google → Seguridad → Verificación en dos pasos → Contraseñas de aplicaciones
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Vercel → Storage → Blob (para las fotos que se suben desde el panel)
BLOB_READ_WRITE_TOKEN=
# Solo para `pnpm db:setup`: tu Gmail, que queda como admin
ADMIN_EMAIL=
ADMIN_NAME=
